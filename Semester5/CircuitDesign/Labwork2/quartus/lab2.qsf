set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE6F17C8
set_global_assignment -name TOP_LEVEL_ENTITY lab2_board
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_WEAK_PULLUP "AS INPUT TRI-STATED"
set_global_assignment -name VERILOG_FILE ../rtl/lab2_board.v
set_global_assignment -name VERILOG_FILE ../rtl/function_multicycle.v
set_global_assignment -name VERILOG_FILE ../rtl/mul_multicycle.v
set_global_assignment -name VERILOG_FILE ../rtl/sqrt_multicycle.v
set_global_assignment -name VERILOG_FILE ../rtl/add_multicycle.v
set_global_assignment -name VERILOG_FILE ../rtl/pll_100mhz.v
set_global_assignment -name SDC_FILE lab2.sdc

set_location_assignment PIN_E1 -to CLK
set_location_assignment PIN_N13 -to RST_N
set_location_assignment PIN_E10 -to LED[0]
set_location_assignment PIN_F9 -to LED[1]

set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to *
set_instance_assignment -name CURRENT_STRENGTH_NEW "8MA" -to LED[*]

set_global_assignment -name LAST_QUARTUS_VERSION "21.1.1 Lite Edition"
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_NO_OUTPUT_GND "AS INPUT TRI-STATED"
